{
  "description": "codelabgen: keep state files CLI-only, log subagent completions",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/codelabgen-hook.sh\" pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/codelabgen-hook.sh\" subagent-stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
