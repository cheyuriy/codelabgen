{
  "$defs": {
    "StepResult": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "env",
            "services",
            "sync",
            "lint",
            "format",
            "offline-tests",
            "live-run",
            "snippets",
            "record",
            "diagrams"
          ],
          "title": "Name",
          "type": "string"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "duration_s": {
          "title": "Duration S",
          "type": "number"
        },
        "log": {
          "description": "Path to the log file, relative to the run directory",
          "title": "Log",
          "type": "string"
        }
      },
      "required": [
        "name",
        "exit_code",
        "duration_s",
        "log"
      ],
      "title": "StepResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "lesson": {
      "title": "Lesson",
      "type": "string"
    },
    "started": {
      "format": "date-time",
      "title": "Started",
      "type": "string"
    },
    "run_dir": {
      "title": "Run Dir",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepResult"
      },
      "title": "Steps",
      "type": "array"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "failed_step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed Step"
    }
  },
  "required": [
    "lesson",
    "started",
    "run_dir",
    "steps",
    "passed"
  ],
  "title": "RunResult",
  "type": "object"
}
