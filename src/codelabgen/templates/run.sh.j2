#!/usr/bin/env bash
# Generated by `codelabgen toc`; edits are overwritten.
#
#   ./run.sh <lesson>        run a lesson (e.g. ./run.sh 1.2)
#   ./run.sh test <lesson>   run a lesson's tests
#   ./run.sh list            list the lessons
#   ./run.sh site [serve|build]   the course as a website (MkDocs)
set -euo pipefail
cd "$(dirname "$0")"
unset VIRTUAL_ENV

# lesson id -> lesson dir | services | sync dir | sync command | run command | test command
lesson_info() {
  case "$1" in
{%- for lesson in lessons %}
    {{ lesson.id }}) printf '%s\n' {{ [lesson.dir, lesson.services, lesson.sync_dir, lesson.sync, lesson.run, lesson.test] | join("|") | shq }} ;;
{%- endfor %}
    *) return 1 ;;
  esac
}

lessons() {
{%- for lesson in lessons %}
  printf '%-8s %s\n' {{ lesson.id | shq }} {{ lesson.title | shq }}
{%- endfor %}
}

prepare() {
  IFS='|' read -r dir services sync_dir sync_cmd run_cmd test_cmd < <(lesson_info "$1") || {
    echo "unknown lesson: $1 (see ./run.sh list)" >&2
    exit 2
  }
  set -a
  [ -f .env ] && . ./.env
  [ -f "$dir/.env" ] && . "$dir/.env"
  set +a
  if [ -n "$services" ]; then
    # shellcheck disable=SC2086
    docker compose up -d --wait $services
  fi
  (cd "$sync_dir" && eval "$sync_cmd")
}

case "${1:-}" in
  "" | -h | --help) sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//' ;;
  list) lessons ;;
  test)
    prepare "${2:?usage: ./run.sh test <lesson>}"
    cd "$dir" && eval "$test_cmd"
    ;;
  site)
    export DISABLE_MKDOCS_2_WARNING=true
    exec uvx --from {{ site_mkdocs }} {% for pkg in site_plugins %}--with {{ pkg }} {% endfor %}mkdocs "${2:-serve}"
    ;;
  *)
    prepare "$1"
    cd "$dir" && eval "exec $run_cmd"
    ;;
esac
